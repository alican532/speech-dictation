# Maintainer: alican532
# CachyOS / Arch: download this file next to the release tarball, then:
#   makepkg -si
pkgname=speech-dictation-bin
pkgver=2.0.0
pkgrel=1
pkgdesc="Tray dictation and translation with Groq Whisper or Gemini Live"
arch=('x86_64')
url="https://github.com/alican532/speech-dictation"
license=('custom:unknown')
depends=('libxcb' 'libxkbcommon-x11' 'libgl' 'alsa-lib')
provides=('speech-dictation')
conflicts=('speech-dictation')
options=('!strip')
source=("SpeechDictation-linux.tar.gz::https://github.com/alican532/speech-dictation/releases/download/v${pkgver}/SpeechDictation-linux.tar.gz")
sha256sums=('SKIP')

package() {
  install -dm755 "$pkgdir/opt/SpeechDictation"
  cp -a "$srcdir/SpeechDictation/." "$pkgdir/opt/SpeechDictation/"
  chmod +x "$pkgdir/opt/SpeechDictation/SpeechDictation"

  install -dm755 "$pkgdir/usr/bin"
  ln -s /opt/SpeechDictation/SpeechDictation "$pkgdir/usr/bin/speech-dictation"

  icon=/opt/SpeechDictation/assets/icon.png
  if [ ! -f "$srcdir/SpeechDictation/assets/icon.png" ] && [ -f "$srcdir/SpeechDictation/_internal/assets/icon.png" ]; then
    icon=/opt/SpeechDictation/_internal/assets/icon.png
  fi

  install -dm755 "$pkgdir/usr/share/applications"
  cat > "$pkgdir/usr/share/applications/speech-dictation.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=SpeechDictation
Comment=Tray dictation with Groq Whisper and Gemini
Exec=/opt/SpeechDictation/SpeechDictation
Icon=$icon
Terminal=false
Categories=Utility;AudioVideo;
StartupNotify=false
EOF
}
